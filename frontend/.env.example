# Server-only upstream. Browser requests always use same-origin /api.
GRIDWATCH_API_TARGET=http://127.0.0.1:8000
# Public, non-secret configuration; compiled into the frontend build.
# Periodic dashboard/saved-area updates; clamped to 5000–300000 ms.
NEXT_PUBLIC_POLL_INTERVAL_MS=30000
# Never enable NEXT_PUBLIC_E2E_TEST in a deployed build.
