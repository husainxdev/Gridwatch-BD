{
  "name": "gridwatch-bd-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 5173",
    "build": "next build",
    "format:check": "prettier --check src app e2e playwright.config.ts next.config.ts postcss.config.mjs tsconfig.json",
    "lint": "next typegen && tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "start": "next start --hostname 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.0",
    "react-icons": "^5.4.0",
    "next": "16.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "daisyui": "^5.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
