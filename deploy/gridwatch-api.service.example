[Unit]
Description=GridWatch BD API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=gridwatch
Group=gridwatch
WorkingDirectory=/srv/gridwatch/backend
EnvironmentFile=/etc/gridwatch/api.env
ExecStart=/srv/gridwatch/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
