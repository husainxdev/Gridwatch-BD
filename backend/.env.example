# Local PostgreSQL URL. Set your own password; never commit .env.
DATABASE_URL=postgresql+psycopg://gridwatch:CHANGE_ME@127.0.0.1:5432/gridwatch
APP_ENV=development
DEMO_ENABLED=true
CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET=SET_A_LONG_RANDOM_VALUE
# Optional SMTP service for password-reset emails
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=no-reply@gridwatch.local
FRONTEND_URL=http://localhost:5173
# For production, set SMTP_STARTTLS=true and provide SMTP_USERNAME/SMTP_PASSWORD securely.
SMTP_STARTTLS=false
# Per-process, per-client-IP, per-auth-endpoint limits (not deployment-wide).
AUTH_RATE_LIMIT=60
AUTH_RATE_WINDOW_SECONDS=60
# Database-backed limits per authenticated reporter; independent of IP.
REPORT_RATE_LIMIT=20
REPORT_BACKDATE_HOURS=24
# Future observations inside this tolerance are retained as pending review, not current facts.
REPORT_FUTURE_SECONDS=300
REPORT_COOLDOWN_SECONDS=600
# Community latest-per-reporter observation window, in minutes (5–1440).
COMMUNITY_WINDOW_MINUTES=60

# Pool maximum per worker = DB_POOL_SIZE + DB_MAX_OVERFLOW (one release worker).
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
# Production requires the exact 40-character commit; scripts/serve.py derives it.
RELEASE_REVISION=unversioned
# Only on an isolated gridwatch_demo_ database; never enable on real user data.
DEMO_INSTANCE=false
